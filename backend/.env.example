# Comma-separated exact frontend origins. Update after deploying the frontend.
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Optional email notifications. If omitted, messages are still stored in SQLite.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-gmail-address@gmail.com
SMTP_PASSWORD=your-16-character-google-app-password
CONTACT_FROM_EMAIL=your-gmail-address@gmail.com
CONTACT_TO_EMAIL=palasettisriram@gmail.com

# Optional. On Render, use a mounted persistent disk path if you have one.
# DATABASE_PATH=/var/data/messages.db
RATE_LIMIT_COUNT=5
RATE_LIMIT_WINDOW_SECONDS=600
